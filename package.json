{
  "name": "infrastructure",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:update": "jest -u",
    "test:unit": "jest tests/unit --coverage",
    "test:security": "jest tests/unit/security",
    "test:security:coverage": "jest tests/unit/security --coverage",
    "test:security:network": "jest tests/unit/security/network-security.test.ts",
    "test:security:instance": "jest tests/unit/security/instance-security.test.ts",
    "test:security:storage": "jest tests/unit/security/storage-security.test.ts",
    "test:security:iam": "jest tests/unit/security/iam-security.test.ts",
    "test:security:monitoring": "jest tests/unit/security/monitoring-logging.test.ts",
    "test:security:application": "jest tests/unit/security/application-security.test.ts",
    "test:security:compliance": "jest tests/unit/security/compliance-governance.test.ts",
    "test:security-posture": "jest tests/unit/security-posture.test.ts",
    "test:connectivity": "jest tests/unit/connectivity",
    "test:connectivity:coverage": "jest tests/unit/connectivity --coverage",
    "test:network-connectivity": "jest tests/unit/connectivity/networking-connectivity.test.ts",
    "test:service-connectivity": "jest tests/unit/connectivity/service-connectivity.test.ts",
    "test:cross-stack-connectivity": "jest tests/unit/connectivity/cross-stack-connectivity.test.ts",
    "test:monitoring": "jest test/unit/monitoring --coverage",
    "test:monitoring:watch": "jest test/unit/monitoring --watch",
    "test:comprehensive": "jest test/unit/monitoring/comprehensive-monitoring.test.ts --coverage",
    "test:ci": "CDK_DOCKER_VERBOSE=false CDK_DEBUG=false CDK_ASSET_VERBOSE=false DOCKER_BUILDKIT=1 BUILDKIT_PROGRESS=quiet jest --coverage --ci --watchAll=false --passWithNoTests",
    "test:update-snapshots": "CDK_DOCKER_VERBOSE=false CDK_DEBUG=false CDK_ASSET_VERBOSE=false DOCKER_BUILDKIT=1 BUILDKIT_PROGRESS=quiet jest --coverage --ci --watchAll=false --passWithNoTests -u",
    "test:monitoring-pipeline": "jest test/unit/monitoring --coverage --ci --watchAll=false --passWithNoTests",
    "test:verbose": "VERBOSE_TESTS=1 jest --verbose",
    "test:validate-patterns": "bash scripts/validate-test-patterns.sh",
    "lint": "eslint . --max-warnings 50",
    "lint:fix": "eslint . --fix",
    "lint:monitoring": "yarn lint:cdk",
    "lint:cdk": "tsc && ENABLE_CDK_NAG=false cdk ls > /dev/null && echo 'CDK validation successful'",
    "typecheck": "tsc --noEmit",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "synth": "cdk synth",
    "integ-runner": "integ-runner",
    "integ:networking": "integ-runner --test-regex networking",
    "integ:update": "integ-runner --update-on-failed"
  },
  "lint-staged": {
    "**/*.test.ts": [
      "eslint --fix",
      "bash scripts/validate-test-patterns.sh"
    ],
    "**/*.ts": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@aws-cdk/integ-runner": "latest",
    "@aws-cdk/integ-tests-alpha": "latest",
    "@aws-sdk/client-dynamodb": "^3.943.0",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/test-sequencer": "^30.2.0",
    "@types/aws-lambda": "^8.10.159",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/source-map-support": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "aws-cdk": "^2.232.1",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.32.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-jest-extended": "^3.0.1",
    "eslint-plugin-jsdoc": "^46.8.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.6.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.18.1"
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.968.0",
    "@aws-sdk/client-cloudformation": "^3.948.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.943.0",
    "@aws-sdk/client-ec2": "^3.943.0",
    "@aws-sdk/client-ecs": "^3.948.0",
    "@aws-sdk/client-efs": "^3.943.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.943.0",
    "@aws-sdk/client-eventbridge": "^3.943.0",
    "@aws-sdk/client-s3": "^3.943.0",
    "@aws-sdk/client-sns": "^3.948.0",
    "@aws-sdk/client-ssm": "^3.943.0",
    "@aws-sdk/client-sts": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "aws-cdk-lib": "^2.232.1",
    "cdk-nag": "^2.37.55",
    "chalk": "^3.0.0",
    "commander": "^12.1.0",
    "constructs": "^10.4.4",
    "dotenv": "^16.3.1",
    "source-map-support": "^0.5.21"
  },
  "packageManager": "yarn@4.12.0"
}
