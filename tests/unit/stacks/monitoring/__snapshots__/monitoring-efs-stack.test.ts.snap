    "PrometheusConfig76F4735C": {
      "Properties": {
        "Description": "Prometheus configuration for development monitoring",
        "Name": "/monitoring/development/prometheus-config",
        "Tags": {
          "Environment": "development",
          "Layer": "Storage",
          "ManagedBy": "CDK",
        },
        "Tier": "Standard",
        "Type": "String",
        "Value": "{
  "global": {
    "scrape_interval": "15s",
    "evaluation_interval": "15s",
    "external_labels": {
      "environment": "development",
      "cluster": "development-monitoring"
    }
  },
  "rule_files": [
    "/etc/prometheus/alerts.yml"
  ],
  "scrape_configs": [
    {
      "job_name": "prometheus",
      "static_configs": [
        {
          "targets": [
            "localhost:9090"
          ]
        }
      ],
      "metrics_path": "/prometheus/metrics"
    },
    {
      "job_name": "node-exporter",
      "static_configs": [
        {
          "targets": [
            "HOST_IP_PLACEHOLDER:9100"
          ]
        }
      ]
    },
    {
      "job_name": "node-exporter-pipeline",
      "ec2_sd_configs": [
        {
          "region": "eu-west-1",
          "port": 9100,
          "filters": [
            {
              "name": "tag:Environment",
              "values": [
                "development"
              ]
            },
            {
              "name": "tag:Service",
              "values": [
                "NodeExporter",
                "monitoring"
              ]
            },
            {
              "name": "instance-state-name",
              "values": [
                "running"
              ]
            }
          ]
        }
      ],
      "relabel_configs": [
        {
          "source_labels": [
            "__meta_ec2_private_ip"
          ],
          "target_label": "__address__",
          "replacement": "\${1}:9100"
        },
        {
          "source_labels": [
            "__meta_ec2_tag_Environment"
          ],
          "target_label": "environment"
        },
        {
          "source_labels": [
            "__meta_ec2_tag_Service"
          ],
          "target_label": "service"
        },
        {
          "source_labels": [
            "__meta_ec2_instance_id"
          ],
          "target_label": "instance_id"
        },
        {
          "source_labels": [
            "__meta_ec2_tag_Name"
          ],
          "target_label": "instance_name"
        }
      ]
    }
  ]
}",
      },
      "Type": "AWS::SSM::Parameter",
    },
    "PrometheusConfigYaml2C828A74": {
      "Properties": {
        "Description": "Prometheus YAML configuration for development monitoring",
        "Name": "/monitoring/development/prometheus-config-yaml",
        "Tags": {
          "Environment": "development",
          "Layer": "Storage",
          "ManagedBy": "CDK",
        },
        "Tier": "Standard",
        "Type": "String",
        "Value": "global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: development
    cluster: development-monitoring
rule_files:
  - /etc/prometheus/alerts.yml
scrape_configs:
  -     job_name: prometheus
        static_configs:
          -         targets:
                      - "localhost:9090"
        metrics_path: /prometheus/metrics
  -     job_name: node-exporter
        static_configs:
          -         targets:
                      - "HOST_IP_PLACEHOLDER:9100"
  -     job_name: node-exporter-pipeline
        ec2_sd_configs:
          -         region: eu-west-1
                    port: 9100
                    filters:
                      -             name: "tag:Environment"
                                    values:
                                      - development
                      -             name: "tag:Service"
                                    values:
                                      - NodeExporter
                                      - monitoring
                      -             name: instance-state-name
                                    values:
                                      - running
        relabel_configs:
          -         source_labels:
                      - __meta_ec2_private_ip
                    target_label: __address__
                    replacement: "\${1}:9100"
          -         source_labels:
                      - __meta_ec2_tag_Environment
                    target_label: environment
          -         source_labels:
                      - __meta_ec2_tag_Service
                    target_label: service
          -         source_labels:
                      - __meta_ec2_instance_id
                    target_label: instance_id
          -         source_labels:
                      - __meta_ec2_tag_Name
                    target_label: instance_name",
      },
      "Type": "AWS::SSM::Parameter",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;
